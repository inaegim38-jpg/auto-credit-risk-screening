# ============================================================
# 기업여신 Screening 데이터 파이프라인 환경변수 템플릿
# 복사하여 .env 로 이름을 변경한 후 실제 API 키 및 DB 정보를 입력하세요.
# (주의: .env 파일은 절대 Git에 커밋하지 마세요!)
# ============================================================

# 1. OpenDART API (https://opendart.fss.or.kr)
DART_API_KEY=your_opendart_api_key_here

# 2. 한국은행 ECOS API (https://ecos.bok.or.kr)
ECOS_API_KEY=your_ecos_api_key_here

# 3. PostgreSQL / Neon Cloud DB 연결 정보
# 방법 A: DATABASE_URL (권장)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-round-recipe-b4nrp8vt-pooler.c-6.us-east-1.aws.neon.tech/dart_ecos?sslmode=require

# 방법 B: 개별 접속 파라미터 (로컬 도커 또는 개별 호스트 연결 시)
DB_HOST=ep-round-recipe-b4nrp8vt-pooler.c-6.us-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=dart_ecos
DB_USER=neondb_owner
DB_PASSWORD=your_password_here
DB_SSLMODE=require
